# This template is copied to .env automatically on first run. Never commit .env.
# npm start runs Gemini reconstruction and its source-specific local backend.
# Gemini must never read this file. Credentials remain on the local Node server.
# The old static export/snapshot workflow is optional: npm run convert.
# The converter is intentionally pinned to gemini-3.8-flash in its runner.
DATA_MODE=desktop
DSCMD_PATH=
PBI_DESKTOP_AUTO_OPEN=true
MODEL_EXPORT_MAX_MB=200

# PostgreSQL settings are used only when the report actually has that connector.
# DATA_MODE is only used by npm run convert.
# Host and database are normally read from PBIP; use overrides only if needed.
# UNC/network CSV paths use your current Windows identity; do not put SMB passwords here.
PG_HOST=
PG_PORT=
PG_DATABASE=
PG_USER=
PG_PASSWORD=
# Native SQL in the PBIP is never executed unless you review it and opt in.
# It runs under the read-only database login and transaction; Power Query steps after SQL are not reproduced.
PG_ALLOW_NATIVE_QUERIES=false
# Optional when native SQL contains $1, $2, ... but the PBIP does not supply a literal M list.
# Map the source ID shown in the error/source picker to positional values. Keep this file private.
# Example: PG_NATIVE_QUERY_PARAMS_JSON='{"source-0":["MENA",2025]}'
PG_NATIVE_QUERY_PARAMS_JSON=

# Use verify-full for TLS validation; disable only if your approved internal setup requires it.
PG_SSL_MODE=verify-full
# Optional path to your organization's PostgreSQL root CA certificate.
PG_SSL_CA_FILE=
# The runner stops rather than silently truncating larger source tables.
PG_MAX_ROWS=50000

# Other file/SQL sources are discovered from the PBIP by Gemini. Add source-specific
# read-only credentials here only when its generated backend/healthcheck requests them.
# Never paste passwords into the PBIP, report HTML, prompts, or this public template.

# Optional converter tuning (defaults shown; test scope / all pages).
# A Gemini attempt stops after this long without any output (8 / 10 minutes):
# GEMINI_IDLE_TIMEOUT_MINUTES=
# ...or after this long in total (20 / 35 minutes):
# GEMINI_ATTEMPT_TIMEOUT_MINUTES=
# Total time for one phase including retries (40 / 90 minutes):
# GEMINI_PHASE_BUDGET_MINUTES=
# Local report server port (the next free port is used if it is taken):
# HC_PORT=8765
# Build even if selected pages need a connector with no driver (placeholders):
# HC_ALLOW_UNSUPPORTED_CONNECTORS=false
# Open the report even if the independent review still blocks it:
# HC_ALLOW_BLOCKED_REVIEW=false
# Skip the PostgreSQL connection test before Gemini runs:
# HC_SKIP_SOURCE_PREFLIGHT=false
